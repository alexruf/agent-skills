#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: tools/unsync-agent-skills [options] [SKILL ...]

Remove symlinks created from this repository in local agent skill paths.

Options:
  --source PATH      Source skills directory. Defaults to ./skills in this repo.
  --target PATH      Target skill directory. Can be repeated.
  --dry-run          Print actions without changing the filesystem.
  --prune-dangling   Also remove dangling symlinks whose raw target ends in
                     /skills/<skill-name> for a current skill. Useful after
                     moving the repository.
  --all              Select every syncable skill for non-interactive use.
  -h, --help         Show this help.

SKILL may be repeated. Without SKILL or --all, an interactive terminal prompts
for a selection. Non-interactive callers must provide SKILL or --all.

Default targets:
  $HOME/.claude/skills
  $HOME/.agents/skills
USAGE
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=lib/skills.sh
. "$repo_root/tools/lib/skills.sh"

source_dir="$repo_root/skills"
dry_run=0
prune_dangling=0
select_all=0
targets=()
skill_names=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --source)
      [ "$#" -ge 2 ] || {
        echo "Missing value for --source" >&2
        exit 2
      }
      source_dir="$2"
      shift 2
      ;;
    --target)
      [ "$#" -ge 2 ] || {
        echo "Missing value for --target" >&2
        exit 2
      }
      targets+=("$2")
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --prune-dangling)
      prune_dangling=1
      shift
      ;;
    --all)
      select_all=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        skill_names+=("$1")
        shift
      done
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      skill_names+=("$1")
      shift
      ;;
  esac
done

if [ ! -d "$source_dir" ]; then
  echo "Source directory does not exist: $source_dir" >&2
  exit 1
fi

if [ "${#targets[@]}" -eq 0 ]; then
  while IFS= read -r target; do
    targets+=("$target")
  done < <(default_skill_targets)
fi

interactive=0
[ -t 0 ] && interactive=1

if selection_output="$(resolve_skill_selection "$source_dir" "$select_all" "$interactive" "${skill_names[@]}")"; then
  :
else
  exit $?
fi

selected_skills=()
if [ -n "$selection_output" ]; then
  while IFS= read -r skill_dir; do
    selected_skills+=("$skill_dir")
  done <<< "$selection_output"
fi

canonical_dir() {
  cd "$1" && pwd -P
}

resolve_link_target() {
  local link_path="$1"
  local raw_target
  local candidate
  local link_dir

  raw_target="$(readlink "$link_path")"
  case "$raw_target" in
    /*)
      candidate="$raw_target"
      ;;
    *)
      link_dir="$(cd "$(dirname "$link_path")" && pwd -P)"
      candidate="$link_dir/$raw_target"
      ;;
  esac

  [ -d "$candidate" ] || return 1
  canonical_dir "$candidate"
}

unsync_one() {
  local skill_dir="$1"
  local source_real="$2"
  local target_dir="$3"
  local name="$4"
  local dest="$target_dir/$name"
  local dest_real

  [ -L "$dest" ] || return 0

  if ! dest_real="$(resolve_link_target "$dest")"; then
    if [ "$prune_dangling" -eq 1 ]; then
      local raw_target
      raw_target="$(readlink "$dest")"
      case "$raw_target" in
        */skills/"$name")
          if [ "$dry_run" -eq 1 ]; then
            echo "unlink (dangling) $dest -> $raw_target"
          else
            unlink "$dest"
            echo "unlinked (dangling) $dest -> $raw_target"
          fi
          return 0
          ;;
      esac
    fi
    echo "Skipping unresolved symlink: $dest" >&2
    return 0
  fi

  if [ "$dest_real" != "$source_real" ]; then
    echo "Skipping external symlink: $dest -> $dest_real" >&2
    return 0
  fi

  if [ "$dry_run" -eq 1 ]; then
    echo "unlink $dest -> $dest_real"
    return 0
  fi

  unlink "$dest"
  echo "unlinked $dest -> $dest_real"
}

declare -A warned_targets=()
found=0
for skill_dir in "${selected_skills[@]}"; do
  found=1
  skill_name="$(basename "$skill_dir")"
  source_real="$(canonical_dir "$skill_dir")"

  for target_dir in "${targets[@]}"; do
    if [ ! -d "$target_dir" ]; then
      if [ -z "${warned_targets[$target_dir]+x}" ]; then
        echo "Skipping missing target directory: $target_dir" >&2
        warned_targets[$target_dir]=1
      fi
      continue
    fi
    unsync_one "$skill_dir" "$source_real" "$target_dir" "$skill_name"
  done
done

if [ "$found" -eq 0 ]; then
  echo "No syncable skills found in $source_dir"
fi

#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
review_scope="$repo_root/skills/code-review/scripts/review-scope"
fixture="$(mktemp -d)"
trap 'rm -rf "$fixture"' EXIT

# Isolate from the user's git config (commit signing, hooks, default branch).
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

clock=1700000000
# commit <name>: adds <name>.txt and commits it with a fixed, increasing date.
commit() {
  clock=$((clock + 60))
  echo "$1" >"$1.txt"
  git add "$1.txt"
  GIT_AUTHOR_DATE="@$clock +0000" GIT_COMMITTER_DATE="@$clock +0000" git commit -q -m "$1"
}

# new_clone <name>: creates <name>-remote with one commit on main, clones it to
# <name>, and changes into the clone.
new_clone() {
  git init -q -b main "$fixture/$1-remote"
  cd "$fixture/$1-remote"
  commit init
  git clone -q "$fixture/$1-remote" "$fixture/$1"
  cd "$fixture/$1"
}

run_scope() {
  output="$("$review_scope" "$@")"
}

# field <key> [column]: prints a column (default 2) of the first record with that key.
field() {
  printf '%s\n' "$output" | awk -F'\t' -v key="$1" -v col="${2:-2}" '$1 == key { print $col; exit }'
}

candidate() {
  printf '%s\n' "$output" | awk -F'\t' -v id="$1" '$1 == "candidate" && $2 == id { print; exit }'
}

expect() {
  local description="$1"
  shift
  "$@" || fail "$description"$'\n'"$output"
}

has_text() {
  case "$1" in *"$2"*) return 0 ;; esac
  return 1
}

# Feature branch: auto when clean, ask once uncommitted changes appear.
new_clone feature
git switch -q -c feature
commit f1
run_scope
expect 'clean feature branch is reviewed automatically' [ "$(field decision)" = auto ]
expect 'clean feature branch recommends branch' [ "$(field recommended)" = branch ]
echo change >>f1.txt
run_scope
expect 'feature branch with uncommitted changes asks' [ "$(field decision)" = ask ]
expect 'ask names the uncommitted changes' has_text "$(field decision 3)" "uncommitted changes"

# Default branch with unpushed commits: auto when clean.
new_clone unpushed
commit local
run_scope
expect 'unpushed commits on main are reviewed automatically' [ "$(field decision)" = auto ]
expect 'unpushed commits recommend unpushed' [ "$(field recommended)" = unpushed ]

# Default branch behind its upstream: only the local commit is in the diff.
new_clone diverged
cd "$fixture/diverged-remote"
commit up1
commit up2
cd "$fixture/diverged"
commit local
git fetch -q
run_scope
merge_base="$(git rev-parse --short "$(git merge-base HEAD origin/main)")"
expect 'unpushed stats exclude upstream commits' has_text "$(candidate unpushed)" $'1 files\t+1/-0'
expect 'unpushed diffs against the merge-base SHA' has_text "$(candidate unpushed)" "git diff $merge_base"

# Clean default branch: nothing to review.
new_clone clean
run_scope
expect 'clean main is empty' [ "$(field decision)" = empty ]
expect 'clean main recommends nothing' [ "$(field recommended)" = none ]

# No remote, trunk not named main or master: ask instead of empty.
git init -q -b trunk "$fixture/nobase"
cd "$fixture/nobase"
commit init
git switch -q -c feature
commit f1
run_scope
expect 'missing base asks' [ "$(field decision)" = ask ]
expect 'ask names the missing base' has_text "$(field decision 3)" "no base branch found"

# No remote, local main: guessed base.
git init -q -b main "$fixture/local"
cd "$fixture/local"
commit init
git switch -q -c feature
commit f1
run_scope
expect 'local main is a guessed base' [ "$(field base)" = "main (guessed)" ]

# Explicit --base sharing the current branch name wins over the upstream.
new_clone fork
git update-ref refs/remotes/upstream/main HEAD
commit a
git update-ref refs/remotes/origin/main HEAD
commit b
run_scope --base upstream/main
fork_base="$(git rev-parse --short upstream/main)"
expect '--base yields a branch candidate' has_text "$(candidate branch)" "git diff $fork_base"
expect '--base suppresses the upstream comparison' [ -z "$(candidate unpushed)" ]

# Stacked branch created locally from its parent.
new_clone stacked
git switch -q -c parent
commit p1
git switch -q -c child
commit c1
run_scope
expect 'stacked branch asks' [ "$(field decision)" = ask ]
expect 'stacked branch recommends stacked' [ "$(field recommended)" = stacked ]
expect 'stacked candidate names the parent' has_text "$(candidate stacked)" "vs parent"
run_scope --base origin/main
expect 'explicit --base skips stacked detection' [ -z "$(candidate stacked)" ]

# Branch checked out from a remote: a later child is not mistaken for a parent.
new_clone remote-checkout
cd "$fixture/remote-checkout-remote"
git switch -q -c feat
commit f1
git switch -q main
cd "$fixture/remote-checkout"
git fetch -q
git checkout -q feat
git switch -q -c child
commit c1
git switch -q feat
commit f2
run_scope
expect 'remote checkout has no stacked candidate' [ -z "$(candidate stacked)" ]
expect 'remote checkout is reviewed automatically' [ "$(field decision)" = auto ]

# Detached HEAD: a branch forked from HEAD's history is not a parent.
new_clone detached
git switch -q -c a
commit a1
git switch -q -c b
commit b1
git switch -q a
commit a2
git checkout -q --detach a
run_scope
expect 'detached HEAD has no stacked candidate' [ -z "$(candidate stacked)" ]
expect 'detached HEAD asks' has_text "$(field decision 3)" "HEAD is detached"

# Over 200 local branches: recent parents still count.
new_clone many
for i in $(seq -w 0 209); do
  echo "create refs/heads/b$i HEAD"
done | git update-ref --stdin
git switch -q -c zzz-parent
commit p1
git switch -q -c child
commit c1
run_scope
expect 'stacked parent past 200 branches is found' has_text "$(candidate stacked)" "vs zzz-parent"

echo "review-scope tests passed"

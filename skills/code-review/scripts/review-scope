#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: review-scope [--base REF] [-- PATH...]

List the candidate review scopes for the current git repository and decide
whether one is clear enough to review without asking. Read-only.

Output is tab-separated, one record per line:
  head         current branch, or "detached <sha>"
  base         "<ref> (<source>)" or "none"; source is --base, origin/HEAD,
               or guessed (first of origin/main, origin/master, main, master)
  upstream     upstream of the current branch, or "none"
  candidate    <id> <n> files <+added/-removed> <label> <diff command>
  decision     auto | ask <reasons> | empty
  recommended  <candidate id>, or "none"

Candidate ids: stacked, branch, unpushed, uncommitted, staged.
Diff commands compare against the working tree, except staged (index vs HEAD),
and end with "-- PATH..." when paths are given.
Untracked files are counted in the stats of every working-tree candidate (line
counts cover only the first 500) but must be listed separately with
git ls-files --others --exclude-standard.

With --base, the branch candidate always diffs against the merge-base with REF
and stacked detection is skipped. "ask" may come with no candidates, for
example when no base branch is found.
EOF
}

die() {
  echo "review-scope: $*" >&2
  exit 2
}

base=""
paths=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --base)
      [ "$#" -ge 2 ] || die "--base needs a ref"
      base="$2"
      shift 2
      ;;
    --)
      shift
      paths=("$@")
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1 (see --help)"
      ;;
  esac
done

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git work tree"
git rev-parse --verify --quiet HEAD >/dev/null || die "repository has no commits yet"

# Prints "<files> <added> <removed>" for `git diff <args>`; binary files count as 0 lines.
diff_stat() {
  git diff --numstat "$@" -- ${paths[@]+"${paths[@]}"} |
    awk '{ f++; if ($1 != "-") a += $1; if ($2 != "-") r += $2 } END { printf "%d %d %d\n", f, a, r }'
}

# Prints the number of commits in <range> that touch the paths.
commits_touching() {
  git rev-list --count "$1" -- ${paths[@]+"${paths[@]}"}
}

# Shell-quoted " -- PATH..." suffix for the printed diff commands.
path_args=""
for path in ${paths[@]+"${paths[@]}"}; do
  path_args="$path_args $(printf '%q' "$path")"
done
[ -z "$path_args" ] || path_args=" --$path_args"

untracked_files=0
untracked_lines=0
max_untracked=500
while IFS= read -r -d '' file; do
  untracked_files=$((untracked_files + 1))
  [ "$untracked_files" -le "$max_untracked" ] || continue
  lines=$(git diff --no-index --numstat -- /dev/null "$file" 2>/dev/null | awk '$1 != "-" { print $1 }' || true)
  untracked_lines=$((untracked_lines + ${lines:-0}))
done < <(git ls-files -z --others --exclude-standard -- ${paths[@]+"${paths[@]}"})

records=()

# add_candidate <id> <stat> <label> <diff command> <include untracked: yes|no>
add_candidate() {
  local id="$1" stat="$2" label="$3" cmd="$4" with_untracked="$5"
  local files added removed
  read -r files added removed <<<"$stat"
  if [ "$with_untracked" = yes ] && [ "$untracked_files" -gt 0 ]; then
    files=$((files + untracked_files))
    added=$((added + untracked_lines))
    label="$label + $untracked_files untracked"
  fi
  [ "$files" -gt 0 ] || return 0
  records+=("$id"$'\t'"$files files"$'\t'"+$added/-$removed"$'\t'"$label"$'\t'"$cmd$path_args")
}

has_candidate() {
  local record
  for record in ${records[@]+"${records[@]}"}; do
    [ "${record%%$'\t'*}" = "$1" ] && return 0
  done
  return 1
}

head_sha=$(git rev-parse HEAD)
short() { git rev-parse --short "$1"; }

if head_branch=$(git symbolic-ref --quiet --short HEAD); then
  head_label="$head_branch"
else
  head_branch=""
  head_label="detached $(short HEAD)"
fi

upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)

base_source="--base"
if [ -n "$base" ]; then
  git rev-parse --verify --quiet "$base^{commit}" >/dev/null || die "base ref not found: $base"
# origin/HEAD dangles after the remote renames its default branch and a prune.
elif base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) &&
  git rev-parse --verify --quiet "$base^{commit}" >/dev/null; then
  base_source="origin/HEAD"
else
  base=""
  for ref in origin/main origin/master main master; do
    if git rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
      base="$ref"
      base_source="guessed"
      break
    fi
  done
fi

# On the default branch when the current branch is the base itself or its local copy.
# An explicit --base always gets a branch comparison against that ref instead.
on_default=no
if [ -n "$head_branch" ] && [ -n "$base" ] && [ "$base_source" != "--base" ]; then
  case "$base" in
    "$head_branch"|*/"$head_branch") on_default=yes ;;
  esac
fi

dirty_stat=$(diff_stat HEAD)
dirty=no
if [ "${dirty_stat%% *}" -gt 0 ] || [ "$untracked_files" -gt 0 ]; then
  dirty=yes
fi
# Appends "+ uncommitted" when tracked files have changes; untracked files are labeled separately.
with_dirty() {
  if [ "${dirty_stat%% *}" -gt 0 ]; then
    echo "$1 + uncommitted"
  else
    echo "$1"
  fi
}

# Prints the commit the current branch was created at, or nothing when the reflog
# does not record a local creation: detached HEAD, expired or missing reflog, or
# a branch checked out from a remote (its first entry is the remote tip, not the
# fork point).
branch_created() {
  [ -n "$head_branch" ] || return 0
  local entry subject from
  entry=$(git reflog show --format='%H %gs' "refs/heads/$head_branch" 2>/dev/null | tail -n 1 || true)
  subject=${entry#* }
  case "$subject" in
    "branch: Created from "*) from=${subject#branch: Created from } ;;
    *) return 0 ;;
  esac
  case "$from" in refs/remotes/*) return 0 ;; esac
  if git show-ref --verify --quiet "refs/remotes/$from"; then
    return 0
  fi
  echo "${entry%% *}"
}

reasons=()

if [ -n "$base" ] && [ "$on_default" = no ]; then
  base_mb=$(git merge-base HEAD "$base" || true)
  if [ -n "$base_mb" ] && [ "$(commits_touching "$base_mb..HEAD")" -gt 0 ]; then
    add_candidate branch "$(diff_stat "$base_mb")" "$(with_dirty "$head_label vs $base")" "git diff $(short "$base_mb")" yes

    # Stacked: another branch shares more history with HEAD than the base does.
    # A parent's fork point predates the current branch; a fork point after the
    # branch was created belongs to a child branch and is ignored. Without a
    # known creation point, children cannot be told apart, so detection is off.
    # An explicit --base is the user's choice and is never second-guessed.
    created=""
    [ "$base_source" = "--base" ] || created=$(branch_created)
    best_ref="" best_mb="" best_distance=""
    while [ -n "$created" ] && IFS= read -r ref; do
      [ "$ref" != "$head_branch" ] && [ "$ref" != "$upstream" ] && [ "$ref" != "$base" ] || continue
      case "$base" in */"$ref") continue ;; esac
      ref_mb=$(git merge-base HEAD "$ref" 2>/dev/null || true)
      [ -n "$ref_mb" ] && [ "$ref_mb" != "$base_mb" ] && [ "$ref_mb" != "$head_sha" ] || continue
      git merge-base --is-ancestor "$base_mb" "$ref_mb" || continue
      git merge-base --is-ancestor "$ref_mb" "$created" || continue
      distance=$(git rev-list --count "$ref_mb..HEAD")
      if [ -z "$best_distance" ] || [ "$distance" -lt "$best_distance" ]; then
        best_ref="$ref" best_mb="$ref_mb" best_distance="$distance"
      elif [ "$distance" -eq "$best_distance" ] && [ "$ref_mb" = "$best_mb" ]; then
        # Same fork point, same diff: name every branch that fits.
        best_ref="$best_ref or $ref"
      fi
    done < <(
      # Most recently active first, so the cap keeps the likely parents.
      git for-each-ref --format='%(refname:short)' --sort=-committerdate --count=200 refs/heads
      for ref in origin/develop origin/development origin/dev; do
        git rev-parse --verify --quiet "$ref^{commit}" >/dev/null && echo "$ref"
      done
    )
    # Only a parent whose own commits touch the paths makes a different diff.
    if [ -n "$best_ref" ] && [ "$(commits_touching "$base_mb..$best_mb")" -gt 0 ]; then
      add_candidate stacked "$(diff_stat "$best_mb")" "$(with_dirty "$head_label vs $best_ref")" "git diff $(short "$best_mb")" yes
      if has_candidate stacked; then
        reasons+=("branch appears stacked on $best_ref")
      fi
    fi

    if [ "$dirty" = yes ] && has_candidate branch; then
      reasons+=("branch has commits and uncommitted changes")
    fi
  fi
fi

if [ "$on_default" = yes ]; then
  compare="${upstream:-$base}"
  if [ "$compare" != "$head_branch" ] && [ "$(commits_touching "$compare..HEAD")" -gt 0 ]; then
    ahead=$(git rev-list --count "$compare..HEAD")
    # The merge-base, not the upstream tip, so upstream commits not yet merged
    # locally do not show up as reverse changes.
    unpushed_mb=$(git merge-base HEAD "$compare")
    add_candidate unpushed "$(diff_stat "$unpushed_mb")" "$(with_dirty "$ahead unpushed commit(s) on $head_branch vs $compare")" "git diff $(short "$unpushed_mb")" yes
    if [ "$dirty" = yes ] && has_candidate unpushed; then
      reasons+=("unpushed commits and uncommitted changes")
    fi
  fi
fi

add_candidate uncommitted "$dirty_stat" "uncommitted changes" "git diff HEAD" yes

staged_stat=$(diff_stat --cached)
unstaged_stat=$(diff_stat)
if [ "${staged_stat%% *}" -gt 0 ] && { [ "${unstaged_stat%% *}" -gt 0 ] || [ "$untracked_files" -gt 0 ]; }; then
  add_candidate staged "$staged_stat" "staged changes only" "git diff --cached" no
fi

[ -n "$head_branch" ] || reasons+=("HEAD is detached")
[ -n "$base" ] || reasons+=("no base branch found")

recommended=none
for id in stacked branch unpushed uncommitted staged; do
  if has_candidate "$id"; then
    recommended="$id"
    break
  fi
done

printf 'head\t%s\n' "$head_label"
if [ -n "$base" ]; then
  printf 'base\t%s (%s)\n' "$base" "$base_source"
else
  printf 'base\tnone\n'
fi
printf 'upstream\t%s\n' "${upstream:-none}"

# Recommended candidate first, the rest in discovery order.
for record in ${records[@]+"${records[@]}"}; do
  [ "${record%%$'\t'*}" = "$recommended" ] && printf 'candidate\t%s\n' "$record"
done
for record in ${records[@]+"${records[@]}"}; do
  [ "${record%%$'\t'*}" = "$recommended" ] || printf 'candidate\t%s\n' "$record"
done

# Reasons win over an empty candidate list: without a base or a branch, an empty
# list does not mean there is nothing to review.
if [ "${#reasons[@]}" -gt 0 ]; then
  joined=$(printf '%s; ' "${reasons[@]}")
  printf 'decision\task\t%s\n' "${joined%; }"
elif [ "${#records[@]}" -eq 0 ]; then
  printf 'decision\tempty\n'
else
  printf 'decision\tauto\n'
fi
printf 'recommended\t%s\n' "$recommended"
